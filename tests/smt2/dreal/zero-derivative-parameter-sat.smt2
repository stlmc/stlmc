(set-logic QF_NRA_ODE)
(declare-fun time_1 () Real [3,3])
(declare-fun g1 () Real [-10,10])
(declare-fun g1_1_0 () Real [8,8])
(declare-fun g1_1_t () Real [-10,10])
(declare-fun d1 () Real [-10,10])
(declare-fun d1_1_0 () Real [0.1,0.1])
(declare-fun d1_1_t () Real [-10,10])
(declare-fun clock () Real [0,10])
(declare-fun clock_1_0 () Real [0,0])
(declare-fun clock_1_t () Real [0,10])
(define-ode flow_2 ((= d/dt[d1] (- 0 (* 0.05 d1))) (= d/dt[g1] 0) (= d/dt[clock] 1)))
(assert (= [d1_1_t g1_1_t clock_1_t] (integral 0. time_1 [d1_1_0 g1_1_0 clock_1_0] flow_2)))
(assert (forall_t 2 [0 time_1] (< g1_1_t 8.5)))
(check-sat)
(exit)
