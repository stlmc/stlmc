# logging: poly
# Corrected model: published polynomials are interpreted as rates and integrated
# using mode-local age a. This is not equivalent to the historical invalid flow.
# Short-window regression goals below were revalidated on the corrected model.
# @benchmark.expected(f1=violated:1, f2=violated:1, f3=violated:1)
# @benchmark.fast(f1, f2)
# @benchmark.z3-slow(f1, f2)
# model description:
#
# There are two fully charged batteries, and a control
# system that switches load between these batteries.
# The goal of the control system is to achieve longer
# battery lifetime.

real b1;
real b2;

[0, 10] g1;
[0, 10] g2;
[-30, 30] d2;
[-30, 30] d1;
[0, 25] a;

# state
# 1 : ON
# 2 : OFF
# 3 : DEAD
{
    mode:
        b1 = 1;
        b2 = 1;
    inv:
 	g1 > 2;
	g2 > 2;
    flow:
	d1(t) = d1(0) + 0.6*t - 0.2*a(0)*t - 0.1*t*t + 0.2*a(0)*a(0)*t + 0.2*a(0)*t*t + (1/15)*t*t*t;
	d2(t) = d2(0) + 0.6*t - 0.2*a(0)*t - 0.1*t*t + 0.2*a(0)*a(0)*t + 0.2*a(0)*t*t + (1/15)*t*t*t;
	a(t) = a(0) + t;
	g1(t) = -0.5 * t + g1(0);
	g2(t) = -0.5 * t + g2(0);
    jump:
        g1 > 1 =>
          (and (a' = 0) (b1' = 1) (b2' = 2) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
        g2 > 1 =>
          (and (a' = 0) (b1' = 2) (b2' = 1) (d1' = d1)  (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
}
{
    mode:
        b1 = 1 ;
        b2 = 2 ;
    inv:
	g1 > 0.5;
	d2 > 1;
    flow:
	d1(t) = d1(0) + 1.1*t - 0.2*a(0)*t - 0.1*t*t + 0.2*a(0)*a(0)*t + 0.2*a(0)*t*t + (1/15)*t*t*t;
	d2(t) = d2(0) - 0.1*t + 0.2*a(0)*t + 0.1*t*t - 0.2*a(0)*a(0)*t - 0.2*a(0)*t*t - (1/15)*t*t*t;
	a(t) = a(0) + t;
	g1(t) = g1(0) - t;
	g2(t) = g2(0);
    jump:
        g2 > 1 =>
          (and (a' = 0) (b1' = 2) (b2' = 1) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
        g1 <=1 =>
          (and (a' = 0) (b1' = 3) (b2' = 1) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
}
{
    mode:
        b1 = 2;
        b2 = 1;
    inv:
	d1 > 1;
	g2 > 0.5;
    flow:
	d1(t) = d1(0) - 0.1*t + 0.2*a(0)*t + 0.1*t*t - 0.2*a(0)*a(0)*t - 0.2*a(0)*t*t - (1/15)*t*t*t;
	d2(t) = d2(0) + 1.1*t - 0.2*a(0)*t - 0.1*t*t + 0.2*a(0)*a(0)*t + 0.2*a(0)*t*t + (1/15)*t*t*t;
	a(t) = a(0) + t;
	g1(t) = g1(0);
	g2(t) = g2(0) - t;
    jump:
	g1 > 1 =>
          (and (a' = 0) (b1' = 1) (b2' = 2) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
        g2 <= 1 =>
          (and (a' = 0) (b1' = 1) (b2' = 3) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));

}
{
    mode:
        b1 = 3;
        b2 = 1;
    inv:
	g1 < 1;
	g2 > 0.5;
    flow:
	d1(t) = d1(0);
	d2(t) = d2(0) + 1.1*t - 0.2*a(0)*t - 0.1*t*t + 0.2*a(0)*a(0)*t + 0.2*a(0)*t*t + (1/15)*t*t*t;
	a(t) = a(0) + t;
	g1(t) = g1(0);
	g2(t) = g2(0) - t;
    jump:
       g2 <= 1 =>
          (and (a' = 0) (b1' = 3) (b2' = 3) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
}
{
    mode:
        b1 = 1;
        b2 = 3;
    inv:
	g1 > 0.5;
	g2 < 1;
    flow:
	d1(t) = d1(0) + 1.1*t - 0.2*a(0)*t - 0.1*t*t + 0.2*a(0)*a(0)*t + 0.2*a(0)*t*t + (1/15)*t*t*t;
	a(t) = a(0) + t;
	d2(t) = d2(0);
	g1(t) = g1(0) - t;
	g2(t) = g2(0);
    jump:
	g1 <= 1 =>
          (and (a' = 0) (b1' = 3) (b2' = 3) (d1' = d1) (d2' = (d2 - 0.122 * g2)) (g1' = g1) (g2' = g2));
}
{
    mode:
        b1 = 3;
        b2 = 3;
    inv:
    flow:
        d1(t) = d1(0);
        d2(t) = d2(0);
        g1(t) = g1(0);
        g2(t) = g2(0);
        a(t) = a(0) + t;
    jump:
}

init:
(and (a = 0) (b1 = 1) (b2 = 1) (8.4 <= g1) (g1 <= 8.5) (0 <= d1) (d1 <= 0.1) (7.4 <= g2) (g2 <= 7.5) (0 <= d2) (d2 <= 0.1)) ;

proposition:

# bound: 10; goal-specific configs use timebound: 2
goal:
[f1]: [][0, 1] ((g2 >= 3) -> <>[0, 1] (d2 >= 4)); # threshold: 2.5
[f2] : ([][0, 1] g2 > 4) U[0, 1] d2 > 1; # threshold: 1
[f3]: <>[0, 1] ((d1 <= 2) U[0, 1] (g1 < 4)); # threshold: 0.5
